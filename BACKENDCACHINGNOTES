caching strategy (Cache-aside) using Redis as the cache and a simulated database 👇

import redis
import time

# Connect to Redis (local instance)
cache = redis.StrictRedis(host='localhost', port=6379, db=0)

# Simulated database (dictionary for demo)
database = {
    "user:1": {"name": "Hari", "role": "Engineer"},
    "user:2": {"name": "Mohan", "role": "Designer"}
}

def get_from_db(key):
    """Simulate database fetch with delay"""
    print("Fetching from DB...")
    time.sleep(1)  # simulate latency
    return database.get(key)

def get_user(key):
    """Cache-aside pattern"""
    # 1. Check cache
    value = cache.get(key)
    if value:
        print("Cache hit!")
        return value.decode("utf-8")

    # 2. Cache miss → fetch from DB
    print("Cache miss!")
    value = get_from_db(key)
    if value:
        # 3. Update cache
        cache.set(key, str(value), ex=30)  # TTL = 30s
    return value

# Demo
print(get_user("user:1"))  # First call → DB + cache
print(get_user("user:1"))  # Second call → Cache hit 


