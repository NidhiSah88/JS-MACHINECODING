🐍 Vector Database Caching Example (Embeddings + FAISS)
import redis
from sentence_transformers import SentenceTransformer
import faiss
import numpy as np

# Connect to Redis
cache = redis.StrictRedis(host="localhost", port=6379, db=0)

# Embedding model
model = SentenceTransformer("all-MiniLM-L6-v2")

# Initialize FAISS index (L2 distance)
dimension = 384  # embedding size for MiniLM
index = faiss.IndexFlatL2(dimension)

# Add some sample vectors to FAISS
texts = ["AI caching systems", "Vector database search", "Redis with embeddings"]
embeddings = model.encode(texts)
index.add(np.array(embeddings))

def get_embedding(text: str):
    key = f"embed:{text}"

    # 1. Check cache
    value = cache.get(key)
    if value:
        print("Cache hit!")
        return np.array(eval(value.decode("utf-8")), dtype=np.float32)

    # 2. Cache miss → compute embedding
    print("Cache miss!")
    embedding = model.encode([text])[0].tolist()

    # 3. Update cache
    cache.set(key, str(embedding), ex=3600)  # TTL = 1 hour
    return np.array(embedding, dtype=np.float32)

def search_vector_db(query: str, k: int = 2):
    embedding = get_embedding(query)
    distances, indices = index.search(np.array([embedding]), k)
    return [(texts[i], float(distances[0][j])) for j, i in enumerate(indices[0])]

# Demo
print(search_vector_db("Redis caching for AI"))
print(search_vector_db("Redis caching for AI"))  # Instant cache hit 
