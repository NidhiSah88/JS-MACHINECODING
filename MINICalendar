const main = document.querySelector("main");

main.innerHTML = `
  <div class="calendar">
    <div class="calendar-header">
      <h2>Day Calendar</h2>
      <span>Today</span>
    </div>

    <div class="calendar-body">
      <div class="time-column"></div>
      <div class="events-column"></div>
    </div>
  </div>
`;

const timeColumn = document.querySelector(".time-column");
const eventsColumn = document.querySelector(".events-column");

const HOUR_HEIGHT = 60;
const TOTAL_HOURS = 24;


// Convert "HH:MM" into minutes
function toMinutes(time) {
  const [hours, minutes] = time.split(":").map(Number);

  return hours * 60 + minutes;
}


// Convert "13:30" into "1:30 PM"
function formatTime(time) {
  const [hours, minutes] = time.split(":").map(Number);

  const hour = hours % 12 || 12;
  const period = hours < 12 ? "AM" : "PM";

  return `${hour}:${String(minutes).padStart(2, "0")} ${period}`;
}


// Check whether two events overlap
function overlaps(event1, event2) {
  const start1 = toMinutes(event1.startTime);
  const end1 = toMinutes(event1.endTime);

  const start2 = toMinutes(event2.startTime);
  const end2 = toMinutes(event2.endTime);

  return start1 < end2 && start2 < end1;
}


// Create time labels
for (let hour = 0; hour < TOTAL_HOURS; hour++) {
  const label = document.createElement("div");

  label.className = "time-label";

  const displayHour = hour % 12 || 12;
  const period = hour < 12 ? "AM" : "PM";

  label.textContent = `${displayHour}:00 ${period}`;

  timeColumn.appendChild(label);
}


// Create hour grid lines
for (let hour = 0; hour <= TOTAL_HOURS; hour++) {
  const line = document.createElement("div");

  line.className = "hour-line";

  line.style.top = `${hour * HOUR_HEIGHT}px`;

  eventsColumn.appendChild(line);
}


// Sort events by start time
const sortedEvents = [...events].sort(
  (a, b) => toMinutes(a.startTime) - toMinutes(b.startTime)
);


// Assign each event to a column
const columns = [];

sortedEvents.forEach((event) => {
  let column = 0;

  while (true) {
    if (!columns[column]) {
      columns[column] = [];
    }

    const conflict = columns[column].some((existingEvent) =>
      overlaps(event, existingEvent)
    );

    if (!conflict) {
      columns[column].push(event);
      event.column = column;
      break;
    }

    column++;
  }
});


// Find how many columns are required for each event
sortedEvents.forEach((event) => {
  const relatedEvents = sortedEvents.filter((other) =>
    overlaps(event, other)
  );

  const maxColumn = Math.max(
    event.column,
    ...relatedEvents.map((item) => item.column)
  );

  event.totalColumns = maxColumn + 1;
});


// Render events
sortedEvents.forEach((event) => {
  const start = toMinutes(event.startTime);
  const end = toMinutes(event.endTime);

  const top = (start / 60) * HOUR_HEIGHT;
  const height = ((end - start) / 60) * HOUR_HEIGHT;

  const width = 100 / event.totalColumns;
  const left = event.column * width;

  const element = document.createElement("div");

  element.className = "event";

  element.style.top = `${top}px`;
  element.style.height = `${height}px`;
  element.style.width = `calc(${width}% - 4px)`;
  element.style.left = `${left}%`;
  element.style.backgroundColor = event.color;

  element.innerHTML = `
    <div class="event-title">${event.title}</div>
    <div class="event-time">
      ${formatTime(event.startTime)} - ${formatTime(event.endTime)}
    </div>
  `;

  eventsColumn.appendChild(element);
});


