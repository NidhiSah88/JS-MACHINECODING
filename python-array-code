Given an array arr[]. The task is to find the largest element and return it.

Examples:

Input: arr[] = [1, 8, 7, 56, 90]
Output: 90
Explanation: The largest element of the given array is 90.

sol:
class Solution:
    def largest(self, arr):
        # code here
        max = arr[0]
        for i in arr:
            if max < i:
                max = i
                
        return max        




class Solution:
    def getMinMax(self, arr):
        # Handle empty array edge case
        if not arr:
            return []
            
        min_val = arr[0]
        max_val = arr[0]
        
        for i in arr:
            if i > max_val:
                max_val = i
            elif i < min_val:
                min_val = i
                
        # In Python, use .append() and pass a list or tuple
        return [min_val, max_val]



