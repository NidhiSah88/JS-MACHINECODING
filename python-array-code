function reverseInGroups(arr, k) {

    for (let i = 0; i < arr.length; i += k) {

        let end = Math.min(i + k, arr.length);

        let group = arr.slice(i, end).reverse();

        arr.splice(i, group.length, ...group);
    }

    return arr;
}


Here:
- slice() extracts the group.
- reverse() reverses it.
- splice() replaces the original elements.
Time: O(n) for this implementation overall, with O(k) auxiliary space.

















































